<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Outpass History</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="navbar">
    <h1>Student Outpass History</h1>
    <a href="/admin/students" class="logout-btn">Back</a>
</div>

<div class="table-container">

    <h2 style="text-align:center; margin-bottom:20px;">
        Register Number: <%= regno %>
    </h2>

    <% if (requests.length === 0) { %>

        <p style="text-align:center; color:#666;">
            No outpass records found for this student.
        </p>

    <% } else { %>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Reason</th>
                <th>Warden</th>
                <th>Out Date</th>
                <th>Out Time</th>
                <th>Return Date</th>
                <th>Return Time</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

        <% requests.forEach(req => { %>

            <tr>
                <td><%= req.id %></td>
                <td><%= req.reason %></td>
                <td><%= req.warden_name || 'N/A' %></td>
                <td><%= req.out_date %></td>
                <td><%= req.out_time %></td>
                <td><%= req.return_date %></td>
                <td><%= req.return_time %></td>
                <td><%= req.status %></td>
            </tr>

        <% }) %>

        </tbody>
    </table>

    <% } %>

</div>

</body>
</html>