<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Security QR Scanner</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/html5-qrcode"></script>
</head>
<body>

    <!-- Navigation Bar -->
    <div class="navbar">
        <h1>Security QR Scanner</h1>
        <a href="/security-dashboard" class="logout-btn">Back</a>
    </div>

    <!-- Scanner Card -->
    <div class="outpass-center">
        <div class="form-card">

            <h2>Scan Student QR Code</h2>
            <p style="text-align:center; color:#666;">
                Scan the student's QR code while leaving or returning
            </p>

            <div id="reader" style="width:100%; margin-top:20px;"></div>

            <p id="result"
               style="text-align:center;
                      margin-top:20px;
                      font-weight:bold;
                      color:#0b63ce;">
            </p>

        </div>
    </div>

<script>
const result = document.getElementById("result");
let scanning = true;
let cameraId = null;

const html5QrCode = new Html5Qrcode("reader");

function onScanSuccess(decodedText) {

    if (!scanning) return;

    scanning = false;

    result.innerHTML = "QR Detected. Verifying...";

    html5QrCode.stop().then(() => {

        fetch("/security/verify", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: decodedText
        })
        .then(res => res.text())
        .then(data => {

            result.innerHTML = data;

            // Restart scanner after 3 seconds
            setTimeout(() => {

                scanning = true;
                result.innerHTML = "";

                html5QrCode.start(
                    cameraId,
                    {
                        fps: 10,
                        qrbox: 250
                    },
                    onScanSuccess
                );

            }, 3000);

        })
        .catch(err => {

            console.log(err);
            result.innerHTML = "Verification failed";

        });

    });

}

Html5Qrcode.getCameras()
.then(cameras => {

    if (cameras && cameras.length) {

        cameraId = cameras[0].id;

        html5QrCode.start(
            cameraId,
            {
                fps: 10,
                qrbox: 250
            },
            onScanSuccess
        );

    } else {

        result.innerHTML = "No camera found";

    }

})
.catch(err => {

    result.innerHTML = "Camera error: " + err;

});
</script>

</body>
</html>